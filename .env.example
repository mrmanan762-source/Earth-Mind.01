# ==============================================================================
# EarthMind Production Configuration Example
#
# IMPORTANT: This file contains safe placeholders only. Do NOT commit real API keys,
# passwords, or secrets to version control.
# ==============================================================================

# Application Execution Environment
# Allowed values: 'production', 'development', 'test', 'staging'
EARTHMIND_ENV=production
EARTHMIND_LOG_LEVEL=INFO
EARTHMIND_DB_PATH=data/earthmind.db

# Model Cache & Storage Directory
# Custom cache location for open-source Hugging Face model weights (bge-m3, bge-reranker-base)
EARTHMIND_MODEL_CACHE_DIR=/var/cache/earthmind/models
# HF_HOME=/var/cache/earthmind/models

# ------------------------------------------------------------------------------
# Qdrant Vector Database Configuration
# ------------------------------------------------------------------------------
# Mode selection: 'remote' (URL/Host) or 'local_persistent' (Disk directory)
EARTHMIND_QDRANT_MODE=remote
EARTHMIND_QDRANT_URL=https://qdrant.internal.earthmind.org:6333
# EARTHMIND_QDRANT_HOST=localhost
# EARTHMIND_QDRANT_PORT=6333
# EARTHMIND_QDRANT_GRPC_PORT=6334
EARTHMIND_QDRANT_API_KEY=your_qdrant_api_key_placeholder
# EARTHMIND_QDRANT_LOCATION=/data/qdrant_storage
EARTHMIND_QDRANT_PREFER_GRPC=false
EARTHMIND_QDRANT_COLLECTION=earthmind_knowledge
EARTHMIND_QDRANT_DISTANCE=COSINE
EARTHMIND_QDRANT_TIMEOUT=30.0
EARTHMIND_QDRANT_AUTO_CREATE=false

# ------------------------------------------------------------------------------
# Embedding Model Configuration (BAAI/bge-m3 Dense Embeddings)
# ------------------------------------------------------------------------------
EARTHMIND_EMBEDDING_PROVIDER=self_hosted
EARTHMIND_EMBEDDING_MODEL=BAAI/bge-m3
EARTHMIND_EMBEDDING_MODEL_VERSION=1.0.0
EARTHMIND_EMBEDDING_DIMENSION=1024
EARTHMIND_EMBEDDING_DEVICE=cpu
EARTHMIND_EMBEDDING_BATCH_SIZE=32
EARTHMIND_EMBEDDING_MAX_LENGTH=8192
EARTHMIND_EMBEDDING_NORMALIZE=true
EARTHMIND_EMBEDDING_ALLOW_DOWNLOAD=true
EARTHMIND_EMBEDDING_EXECUTION_MODE=self_hosted
EARTHMIND_EMBEDDING_TIMEOUT=30.0

# ------------------------------------------------------------------------------
# Sparse Representation Configuration (BM25 Lexical Vectors)
# ------------------------------------------------------------------------------
EARTHMIND_SPARSE_PROVIDER=bm25
EARTHMIND_SPARSE_MODEL=earthmind-bm25-v1
EARTHMIND_SPARSE_TIMEOUT=10.0

# ------------------------------------------------------------------------------
# Hybrid Retrieval Fusion Configuration (Stage R7)
# ------------------------------------------------------------------------------
EARTHMIND_FUSION_STRATEGY=rrf
EARTHMIND_FUSION_RRF_K=60
EARTHMIND_FUSION_DENSE_WEIGHT=0.5
EARTHMIND_FUSION_SPARSE_WEIGHT=0.5
EARTHMIND_FUSION_TIMEOUT=10.0

# ------------------------------------------------------------------------------
# Neural Reranking Configuration (BAAI/bge-reranker-base Stage R8)
# ------------------------------------------------------------------------------
EARTHMIND_RERANK_PROVIDER=cross_encoder
EARTHMIND_RERANK_MODEL=BAAI/bge-reranker-base
EARTHMIND_RERANK_MODEL_VERSION=1.0.0
EARTHMIND_RERANK_DEVICE=cpu
EARTHMIND_RERANK_BATCH_SIZE=32
EARTHMIND_RERANK_MAX_CANDIDATE_COUNT=100
EARTHMIND_RERANK_MAX_INPUT_LENGTH=512
EARTHMIND_RERANK_TIMEOUT=10.0
EARTHMIND_RERANK_CANDIDATE_LIMIT=10
EARTHMIND_RERANK_FALLBACK_POLICY=PRESERVE_FUSED_ORDER
EARTHMIND_RERANK_SCORE_NORMALIZATION=NONE
EARTHMIND_RERANK_DETERMINISTIC_ORDERING=HIGHER_SCORE_FIRST
EARTHMIND_RERANK_ALLOW_DOWNLOAD=true

# ------------------------------------------------------------------------------
# Stage R9 Query Processing Configuration
# ------------------------------------------------------------------------------
EARTHMIND_QUERY_MAX_LENGTH=1000
EARTHMIND_QUERY_MIN_LENGTH=1
EARTHMIND_QUERY_EXPANSION_ENABLED=true
EARTHMIND_QUERY_MAX_EXPANSIONS=3
EARTHMIND_QUERY_DEFAULT_LANG=hi
EARTHMIND_QUERY_DEFAULT_TOP_K=10
EARTHMIND_QUERY_DEFAULT_DENSE_TOP_K=20
EARTHMIND_QUERY_DEFAULT_SPARSE_TOP_K=20
EARTHMIND_QUERY_COLLECTION=earthmind_knowledge
EARTHMIND_QUERY_TIMEOUT=10.0

# ------------------------------------------------------------------------------
# Stage R10 Web Search Configuration
# ------------------------------------------------------------------------------
EARTHMIND_WEB_SEARCH_PROVIDER=api
EARTHMIND_WEB_SEARCH_API_KEY=your_web_search_api_key_placeholder
EARTHMIND_WEB_SEARCH_ENDPOINT=https://api.search.internal.earthmind.org/v1/search
EARTHMIND_WEB_SEARCH_TIMEOUT=10.0
EARTHMIND_WEB_SEARCH_MAX_RESULTS=10
EARTHMIND_WEB_SEARCH_SAFE_SEARCH=true

# ------------------------------------------------------------------------------
# Stage R11 Evidence Builder & Stage R12 Evidence Validator
# ------------------------------------------------------------------------------
EARTHMIND_EVIDENCE_MAX_ITEMS=20
EARTHMIND_EVIDENCE_MAX_CONTENT_LENGTH=2000
EARTHMIND_EVIDENCE_DEDUPLICATE=true
EARTHMIND_VALIDATOR_STRICT_MODE=false
EARTHMIND_VALIDATOR_MAX_ITEMS=100

# ------------------------------------------------------------------------------
# Stage R13 RAG Integration & B2 Context Manager
# ------------------------------------------------------------------------------
EARTHMIND_RAG_ENABLE_WEB_SEARCH=true
EARTHMIND_RAG_MAX_RESULTS=10
EARTHMIND_RAG_STRICT_VALIDATION=false
EARTHMIND_RAG_TIMEOUT=15.0
EARTHMIND_CONTEXT_DEFAULT_TOKEN_LIMIT=4096
EARTHMIND_CONTEXT_RELEVANCE_THRESHOLD=0.5
EARTHMIND_CONTEXT_TIMEOUT=5.0
